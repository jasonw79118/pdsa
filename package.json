{
  "name": "pdsa-public-site-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Palo Duro Soccer Association public website preview",
  "scripts": {
    "test": "node tests/node-smoke.cjs && node tests/payment-workflow.cjs && node tests/stripe-gateway.cjs && node --test tests/family-profile-validation.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
