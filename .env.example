# Server-side only. This file is a template; never put secrets in GitHub Pages/frontend code.
# DATABASE_URL=                    # server runtime only; never VITE_ or browser exposed
# VITE_NEON_AUTH_URL=              # public Managed Auth URL for the frontend; not a secret
# VITE_FAMILY_API_URL=             # public URL for the Neon family API function
# APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # server CORS allowlist; set deployed app origin separately
# AUTH_BASE_URL=                   # server-side JWT issuer for the matching Neon Auth branch
# AUTH_JWKS_URL=                   # server-side JWKS endpoint for that same Auth branch
# FAMILY_API_DATABASE_URL=         # restricted NOSUPERUSER/NOBYPASSRLS DB role; never use owner credentials
# PDSA_STRIPE_SECRET_KEY=           # restricted secret manager in deployment
# PDSA_STRIPE_WEBHOOK_SECRET=       # separate endpoint/signing secret
# PDSA_STRIPE_ACCOUNT_REF=          # non-secret account reference for audit/config
# TECHFORM_STRIPE_SECRET_KEY=       # separate merchant account and settlement
# TECHFORM_STRIPE_WEBHOOK_SECRET=   # separate endpoint/signing secret
# TECHFORM_STRIPE_ACCOUNT_REF=      # non-secret account reference for audit/config
# STRIPE_MODE=test                  # live mode requires explicit approval and launch gate
# PUBLIC_APP_ORIGIN=                # server allowlist for checkout return URLs
# WEATHER_PROVIDER_ENDPOINT= # call through secure backend, not safety source of truth
# CITY_LIGHTNING_FEED_URL= # pending written city/vendor permission and technical verification
# FACEBOOK_PAGE_ID= # Page tokens must remain on server
